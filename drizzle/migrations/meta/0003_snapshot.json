        "usuarios_numero_registro_formato": {
          "name": "usuarios_numero_registro_formato",
          "value": "length(\"usuarios\".\"numero_registro\") = 16\n    AND \"usuarios\".\"numero_registro\" LIKE 'APPD-____-______'\n    AND \"usuarios\".\"numero_registro\" NOT GLOB '*[^A-Z0-9-]*'\n    AND substr(\"usuarios\".\"numero_registro\", 11, 6) NOT GLOB '*[^A-Z2-9]*'"
        },
        "usuarios_situacao": {
          "name": "usuarios_situacao",
          "value": "\"usuarios\".\"situacao\" IN ('ativo', 'inativo')"
        },
        "usuarios_email_normalizado": {
          "name": "usuarios_email_normalizado",
          "value": "\"usuarios\".\"email\" IS NULL OR (\"usuarios\".\"email\" = lower(\"usuarios\".\"email\") AND \"usuarios\".\"email\" = trim(\"usuarios\".\"email\"))"
        },
        "usuarios_cpf_digitos": {
          "name": "usuarios_cpf_digitos",
          "value": "\"usuarios\".\"cpf\" IS NULL OR (length(\"usuarios\".\"cpf\") = 11 AND \"usuarios\".\"cpf\" NOT GLOB '*[^0-9]*')"
        },
        "usuarios_nome_tamanho": {
          "name": "usuarios_nome_tamanho",
          "value": "\"usuarios\".\"nome\" IS NULL OR length(\"usuarios\".\"nome\") BETWEEN 2 AND 120"
        },
        "usuarios_nascimento_formato": {
          "name": "usuarios_nascimento_formato",
          "value": "\"usuarios\".\"nascimento\" IS NULL OR (length(\"usuarios\".\"nascimento\") = 10\n    AND \"usuarios\".\"nascimento\" LIKE '____-__-__'\n    AND \"usuarios\".\"nascimento\" NOT GLOB '*[^0-9-]*')"
        },
        "usuarios_telefone_digitos": {
          "name": "usuarios_telefone_digitos",
          "value": "\"usuarios\".\"telefone\" IS NULL OR (\"usuarios\".\"telefone\" NOT GLOB '*[^0-9]*' AND length(\"usuarios\".\"telefone\") IN (10, 11))"
        },
        "usuarios_whatsapp": {
          "name": "usuarios_whatsapp",
          "value": "\"usuarios\".\"telefone_whatsapp\" IS NULL OR \"usuarios\".\"telefone_whatsapp\" IN ('Sim', 'Não')"
        },
        "usuarios_cep_digitos": {
          "name": "usuarios_cep_digitos",
          "value": "\"usuarios\".\"cep\" IS NULL OR (length(\"usuarios\".\"cep\") = 8 AND \"usuarios\".\"cep\" NOT GLOB '*[^0-9]*')"
        },
        "usuarios_endereco_tamanho": {
          "name": "usuarios_endereco_tamanho",
          "value": "\"usuarios\".\"endereco\" IS NULL OR length(\"usuarios\".\"endereco\") BETWEEN 3 AND 300"
        },
        "usuarios_numero_tamanho": {
          "name": "usuarios_numero_tamanho",
          "value": "\"usuarios\".\"numero\" IS NULL OR length(\"usuarios\".\"numero\") BETWEEN 1 AND 20"
        },
        "usuarios_complemento_tamanho": {
          "name": "usuarios_complemento_tamanho",
          "value": "\"usuarios\".\"complemento\" IS NULL OR length(\"usuarios\".\"complemento\") <= 60"
        },
        "usuarios_bairro_tamanho": {
          "name": "usuarios_bairro_tamanho",
          "value": "\"usuarios\".\"bairro\" IS NULL OR length(\"usuarios\".\"bairro\") BETWEEN 2 AND 80"
        },
        "usuarios_municipio_tamanho": {
          "name": "usuarios_municipio_tamanho",
          "value": "\"usuarios\".\"municipio\" IS NULL OR length(\"usuarios\".\"municipio\") BETWEEN 2 AND 80"
        },
        "usuarios_cuidador_nome_tamanho": {
          "name": "usuarios_cuidador_nome_tamanho",
          "value": "\"usuarios\".\"cuidador_nome\" IS NULL OR length(\"usuarios\".\"cuidador_nome\") <= 120"
        },
        "usuarios_cuidador_contato_digitos": {
          "name": "usuarios_cuidador_contato_digitos",
          "value": "\"usuarios\".\"cuidador_contato\" IS NULL OR (\"usuarios\".\"cuidador_contato\" NOT GLOB '*[^0-9]*' AND length(\"usuarios\".\"cuidador_contato\") IN (10, 11))"
        },
        "usuarios_criado_em_utc": {
