          "value": "length(\"usuarios\".\"criado_em\") = 20\n    AND \"usuarios\".\"criado_em\" LIKE '____-__-__T__:__:__Z'\n    AND \"usuarios\".\"criado_em\" NOT GLOB '*[^0-9:TZ-]*'"
