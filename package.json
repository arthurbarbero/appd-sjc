{
  "name": "appd-sjc",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:aplicar:local": "wrangler d1 migrations apply appd-sjc --local",
    "cf:dev": "node scripts/parar-workerd.mjs && npm run build && wrangler dev",
    "db:seed:local": "node scripts/seed-local.mjs > .wrangler/seed.sql && wrangler d1 execute appd-sjc --local --file=.wrangler/seed.sql",
    "cf:parar": "node scripts/parar-workerd.mjs",
    "aceite": "node scripts/parar-workerd.mjs && npm run build && node test/aceite/percurso.mjs"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@noble/hashes": "^2.3.0",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.5.1",
    "nuxt-auth-utils": "^0.5.30",
    "uqr": "^0.1.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "^4.1.0",
    "@vue/test-utils": "^2.4.11",
    "axe-core": "^4.13.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.11.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9",
    "wrangler": "^4.119.0"
  }
}
